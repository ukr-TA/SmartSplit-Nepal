# Copy this file to `.env` (cp .env.example .env) and fill in your own values.
# Never commit the real .env file.

# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_NAME=smartsplit
DATABASE_USER=smartsplit
DATABASE_PASSWORD=your-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# The React dev server address(es) allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the React app runs (payment gateways redirect back here)
FRONTEND_URL=http://localhost:5173

# --- eSewa (test environment) ---------------------------------------------
# Works out of the box with eSewa's public test credentials. Set to False to
# hide the "eSewa test gateway" option and use only the in-app simulation.
ESEWA_ENABLED=True

# --- Khalti (sandbox) -----------------------------------------------------
# Optional. Paste your test "live_secret_key" from https://test-admin.khalti.com
# Leave empty to use the in-app Khalti simulation only.
KHALTI_SECRET_KEY=
